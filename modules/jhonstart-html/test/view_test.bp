// Decision 276: `View` is `@Component<ElementBase, Element>` under a shorter
// name. A function declared with one spelling returns a call of a function
// declared with the other, both ways.

import {Element, ElementBase, View, p, text, renderNode} from "jhonstart";

fn spelledInFull() -> @Component<ElementBase, Element> {
    return p([text("full")], attrs: []);
}

fn spelledAsView() -> View {
    return spelledInFull();
}

fn backInFull() -> @Component<ElementBase, Element> {
    return spelledAsView();
}

test "-> View and -> @Component<ElementBase, Element> accept one another" {
    val viewed = await spelledAsView();
    val full = await backInFull();
    assert renderNode(viewed) == "<p>full</p>";
    assert renderNode(full) == "<p>full</p>";
}
