// `botopink test` flat suite for `src/router.bp` (front 26).
//
// Written from a CONSUMER's position, the way `elements_test.bp` is: the
// module under test is reached by its module name, so what the suite exercises
// is the surface a `from "jhonstart"` consumer gets, not the module's private
// interior.
//
// Both rows run this file. The front's assigned target is erlang and every
// assertion below RUNS there; the commonJS row runs the same assertions
// against the `.mjs` half of the same cells.

import {
    RouterState,
    pairValue,
    patternSegments,
    segmentAt,
    decodePairs,
    fill,
    snapshot,
} from "router";

// ── step 1: the record and its accessors ────────────────────────────────────

fn blogPost() -> RouterState {
    return RouterState(
        path: "/blog/hi",
        params: [#("slug", "hi")],
        search: [],
        pattern: "/blog/[slug]",
        selected: 0,
    );
}

test "router: a param is read by name" {
    assert blogPost().param("slug") == "hi";
}

test "router: an absent param is the empty string, not a runtime error" {
    assert blogPost().param("nope") == "";
    assert blogPost().searchParam("nope") == "";
}

test "router: searchParam reads the search list, not the params list" {
    val r = RouterState(
        path: "/blog",
        params: [#("slug", "hi")],
        search: [#("sort", "new")],
        pattern: "/blog",
        selected: 0,
    );
    assert r.searchParam("sort") == "new";
    assert r.searchParam("slug") == "";
    assert r.param("sort") == "";
}

test "router: pairValue answers the FIRST match of a duplicated key" {
    val dup = [#("tag", "one"), #("tag", "two")];
    assert pairValue(dup, "tag") == "one";
    assert pairValue([], "tag") == "";
}

test "router: segments keep the bracket spelling and drop the empty parts" {
    val segs = blogPost().segments();
    assert segs.length == 2;
    assert segmentAt(segs, 0) == "blog";
    assert segmentAt(segs, 1) == "[slug]";
    assert patternSegments("/").length == 0;
    assert patternSegments("").length == 0;
}

test "router: segment answers the layout depth, and out of range is empty" {
    assert blogPost().segment() == "blog";
    val deeper = RouterState(
        path: "/blog/hi",
        params: [],
        search: [],
        pattern: "/blog/[slug]",
        selected: 1,
    );
    assert deeper.segment() == "[slug]";
    val past = RouterState(
        path: "/blog/hi",
        params: [],
        search: [],
        pattern: "/blog/[slug]",
        selected: 7,
    );
    assert past.segment() == "";
}

// ── the pair-list decoder ───────────────────────────────────────────────────

test "router: decodePairs splits ampersand-separated pairs in order" {
    val out = decodePairs("a=1&b=2&c=3");
    assert out.length == 3;
    assert pairValue(out, "a") == "1";
    assert pairValue(out, "b") == "2";
    assert pairValue(out, "c") == "3";
}

test "router: decodePairs strips a leading question mark" {
    val out = decodePairs("?x=42");
    assert out.length == 1;
    assert pairValue(out, "x") == "42";
}

test "router: an empty query decodes to the empty list, not one empty pair" {
    assert decodePairs("").length == 0;
    assert decodePairs("?").length == 0;
    assert decodePairs("&&").length == 0;
}

test "router: a chunk with no `=` decodes to an empty value" {
    val out = decodePairs("flag");
    assert out.length == 1;
    assert pairValue(out, "flag") == "";
}

test "router: an empty value is preserved" {
    val out = decodePairs("q=&r=1");
    assert out.length == 2;
    assert pairValue(out, "q") == "";
    assert pairValue(out, "r") == "1";
}

// ── step 2: the five cells and the snapshot builder ─────────────────────────
//
// `fill` is the stub the front's test plan asks for, and it is the same seam
// front 28's server adapter and fronts 27/29's client transition use. Both
// rows run these: on erlang the store is the calling process's dictionary
// (`src/sidecars/jhonstart_router.erl`), on commonJS a module-global
// (`src/router_runtime.mjs`), and the assertions do not know which.

test "router: the five cells round-trip into the record of step 1" {
    val ignored = fill("/blog/hi", "slug=hi", "", "/blog/[slug]", 0);
    val r = snapshot();
    assert r.path == "/blog/hi";
    assert r.pattern == "/blog/[slug]";
    assert r.selected == 0;
    assert r.param("slug") == "hi";
    assert r.params.length == 1;
    assert r.search.length == 0;
}

test "router: an empty params string yields the empty list, not one empty pair" {
    val ignored = fill("/", "", "", "/", 0);
    val r = snapshot();
    assert r.params.length == 0;
    assert r.search.length == 0;
    assert r.param("anything") == "";
}

test "router: the search list comes back through the same decoder" {
    val ignored = fill("/blog", "", "sort=new&page=2", "/blog", 0);
    val r = snapshot();
    assert r.search.length == 2;
    assert r.searchParam("sort") == "new";
    assert r.searchParam("page") == "2";
    assert r.searchParam("missing") == "";
}

test "router: selected reaches the record and drives segment()" {
    val ignored = fill("/blog/hi", "slug=hi", "", "/blog/[slug]", 1);
    assert snapshot().segment() == "[slug]";
    val again = fill("/blog/hi", "slug=hi", "", "/blog/[slug]", 0);
    assert snapshot().segment() == "blog";
}

test "router: a fill replaces the WHOLE snapshot, never one field of it" {
    val first = fill("/a", "x=1", "s=1", "/a", 0);
    val second = fill("/b", "", "", "/b", 0);
    val r = snapshot();
    assert r.path == "/b";
    assert r.param("x") == "";
    assert r.searchParam("s") == "";
}
