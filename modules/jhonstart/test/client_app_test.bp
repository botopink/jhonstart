// `botopink test` flat suite for `src/client_app.bp` (front 26 Step 6): a
// client-only app. With no `window` the location and the mount are
// `client_app.mjs`'s module store (and its BEAM twin), so the start, the two
// signals and the target check run on both rows. The front's gate for
// `clientApp` is the commonJS row.

import {Element, ElementBase, text, div, p} from "element";
import {main, h2} from "elements";
import {cookies} from "server";
import {notFound, redirect} from "error_boundary";
import {lastNavigation} from "router";
import {
    page,
    layout,
    PageContext,
    LayoutProps,
    jhPage,
    jhLayout,
    jhNotFound,
    ctxParam,
    ctxRest,
} from "routes";
import {ClientApp, clientApp, setClientLocation, mountedHtml, replacedLocation} from "client_app";

#[layout("ca")]
pub fn CaLayout(props: LayoutProps) -> @Component<ElementBase, Element> {
    return main([props.children], attrs: [#("class", "ca")]);
}

#[page("ca/[id]")]
pub fn caItem(route: PageContext) -> @Component<ElementBase, Element> {
    val ps = caItemParams(route);
    return p([text("item " + ps.id, attrs: [])], attrs: []);
}

#[page("ca/login")]
pub fn caLogin(route: PageContext) -> @Component<ElementBase, Element> {
    return p([text("login", attrs: [])], attrs: []);
}

#[page("ca/missing")]
pub fn caMissing(route: PageContext) -> @Component<ElementBase, Element> {
    notFound();
    return p([], attrs: []);
}

#[page("ca/private")]
pub fn caPrivate(route: PageContext) -> @Component<ElementBase, Element> {
    redirect("/ca/login");
    return p([text("secret", attrs: [])], attrs: []);
}

#[page("ca/nowhere")]
pub fn caNowhere(route: PageContext) -> @Component<ElementBase, Element> {
    redirect("/nope");
    return p([], attrs: []);
}

#[page("ca/evil")]
pub fn caEvil(route: PageContext) -> @Component<ElementBase, Element> {
    redirect("https://evil.example");
    return p([], attrs: []);
}

fn CaNotFound() -> Element {
    return div([h2([text("no such item", attrs: [])], attrs: [])], attrs: []);
}

val __caNotFound = jhNotFound("ca", { -> CaNotFound() });

val table = "L|/ca\nP|/ca/[id]\nP|/ca/login\nP|/ca/missing\nP|/ca/private\nP|/ca/nowhere\nP|/ca/evil";

fn outcomeText(r: @Result<void, string>) -> string {
    return case r {
        Ok(v) -> "ok";
        Error(message) -> message;
    };
}

test "clientApp: start renders the matched route into mount, the layout before the page" {
    setClientLocation("/ca/7", "");
    val out = await clientApp(table, "#root", []).start();
    assert outcomeText(out) == "ok";
    assert mountedHtml("#root") == "<main class=\"ca\"><div data-jh-n=\"/ca\"><p>item 7</p></div></main>";
}

test "clientApp: notFound renders the route's not-found boundary and leaves the URL alone" {
    setClientLocation("/ca/missing", "");
    val out = await clientApp(table, "#root", []).start();
    assert outcomeText(out) == "ok";
    assert mountedHtml("#root") == "<div data-jh-n=\"/ca\"><div><h2>no such item</h2></div></div>";
    assert replacedLocation() == "";
}

test "clientApp: a relative redirect in routes is a replaceState and a client navigation" {
    setClientLocation("/ca/private", "");
    val out = await clientApp(table, "#root", []).start();
    assert outcomeText(out) == "ok";
    assert lastNavigation() == "replace /ca/login";
    assert mountedHtml("#root").contains("<p>login</p>");
    assert mountedHtml("#root").contains("secret") == false;
}

test "clientApp: an unlisted target fails the start and navigates nowhere; a listed absolute one is location.replace" {
    setClientLocation("/ca/nowhere", "");
    val nowhere = await clientApp(table, "#root", []).start();
    assert outcomeText(nowhere).contains("`/nope` refused");
    assert mountedHtml("#root") == "";
    setClientLocation("/ca/evil", "");
    val evil = await clientApp(table, "#root", []).start();
    assert outcomeText(evil).contains("`https://evil.example` refused");
    assert replacedLocation() == "";
    setClientLocation("/ca/evil", "");
    val listed = await clientApp(table, "#root", ["https://evil.example"]).start();
    assert outcomeText(listed) == "ok";
    assert replacedLocation() == "https://evil.example";
}
