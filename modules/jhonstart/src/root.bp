//// The `jhonstart` package — module-tree root.
////
//// The compiled UI core: `element` (the `Element` tree + builders + SSR
//// renderer), `hooks` (the `state`/`effect`/`memo`/`ref`/`reducer` family —
//// `hooks` imports `Element` from `element`), and `html` (the `html """…"""`
//// markup DSL that expands to the builder pipeline). All three are public
//// surface, reached by a consumer via `import {…} from "jhonstart"`.
////
//// `router` (front 26) is the route snapshot a component reads — a compiled
//// module since the promotion of `router.d.bp`. What is left of the
//// host-bound surface stays in a declaration module — `server.d.bp` (the Http
//// server context) — wired through `botopink.json` `files` (loaded with
//// `.declaration = true` for a consumer), not the build tree: `.d.bp` modules
//// are not resolved by `mod` paths, mirroring how `libs/std` keeps its
//// ambient `.d.bp` out of `root.bp`.

pub mod element;
pub mod hooks;
pub mod html;
pub mod router;       // front 26, replacing router.d.bp
pub mod elements;     // front 94
mod client_runtime;
