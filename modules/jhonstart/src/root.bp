//// The `jhonstart` package — module-tree root.
////
//// The compiled UI core: `element` (the `Element` tree + builders + SSR
//// renderer) and `hooks` (the `state`/`effect`/`memo`/`ref`/`reducer` family —
//// `hooks` imports `Element` from `element`). Both are public surface, reached
//// by a consumer via `import {…} from "jhonstart"`. The `html """…"""` markup
//// DSL is not here: it is the `jhonstart-html` member since front 95, and the
//// core does not depend on it.
////
//// `router` (front 26) is the route snapshot a component reads and `server`
//// (front 28) is the request a server component reads, both compiled modules
//// since the promotion of `router.d.bp` and `server.d.bp`. No host-bound
//// declaration module is left: what was `.d.bp` because it called a host now
//// ships its host half beside it (`router_runtime.mjs` /
//// `sidecars/jhonstart_router.erl`, `server_runtime.mjs` /
//// `sidecars/jhonstart_server.erl`), cell for cell on both rows.
////
//// `link` and `reconcile` (front 27) are the render-time half of client
//// navigation: the anchor, its props, the prefetch decision and the remount
//// decision. Both are PURE — no host cell of any target — so they render and
//// assert on both rows. The browser half they are the input to
//// (`__jhLinkMount`, `__jhLinkPrefetch`, `__jhLinkStatus`,
//// `__jhLinkRouteKind`, and the transition driver) lives in front 68's
//// generated bundle and is not declared here until that module exists; see
//// `link.bp`'s header.

pub mod element;
pub mod hooks;
pub mod router;       // front 26, replacing router.d.bp
pub mod link;         // front 27
pub mod reconcile;    // front 27
pub mod server;       // front 28, replacing server.d.bp
pub mod client;       // front 29
pub mod error_boundary; // front 31
pub mod metadata;     // front 32
pub mod elements;     // front 94
mod client_runtime;
