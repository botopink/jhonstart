pub declare fn __jhTryTask<T>(f: fn() -> @Task<T>) -> @Task<@Result<T, string>>;

#[@External.Node("./signal_runtime.mjs", "tryTask"),
  @External.Erlang("jhonstart_signal", "try_task")]
pub declare fn __jhTryComponent(f: fn() -> @Component<ElementBase, Element>) -> @Task<@Result<Element, string>>;

#[@External.Node("./signal_runtime.mjs", "tryValue"),
  @External.Erlang("jhonstart_signal", "try_value")]
