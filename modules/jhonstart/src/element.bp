// jhonstart/element — the UI core, implemented in *real* botopink.

// The base every jhonstart hook anchors at (decisions 96 and 102 of botopink
// 1.0.10-beta): `Element` carries the tree and names it in
// `implement @Context<ElementBase>`, so a component is
// `#[@use] fn … -> @Component<ElementBase, Element>` and a hook
// `#[@use] fn … -> @Component<ElementBase, T>`. A phantom — never constructed.
pub type ElementBase(root: bool)

pub type Element(
    tag: string,
    value: string,
    children: Children,
    attrs: Array<#(string, string)>,
) implement @Context<ElementBase>

pub fn bracketPair(name: string, value: string) -> #(string, string) {
    return #(name, value);
}

pub fn text(value: string, attrs: Array<#(string, string)> = []) -> Element {
    return Element(tag: "#text", value: value, children: [], attrs: attrs);
}

pub fn fragment(
    children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return Element(tag: "#fragment", value: "", children: children, attrs: attrs);
}

pub fn div(
    children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return Element(tag: "div", value: "", children: children, attrs: attrs);
}

pub fn span(
    children: Children,
    attrs: Array<#(string, string)> = [],
) -> Element {
    return Element(tag: "span", value: "", children: children, attrs: attrs);
}

pub fn p(children: Children, attrs: Array<#(string, string)> = []) -> Element {
    return Element(tag: "p", value: "", children: children, attrs: attrs);
}

pub fn h1(children: Children, attrs: Array<#(string, string)> = []) -> Element {
    return Element(tag: "h1", value: "", children: children, attrs: attrs);
}

pub fn ul(children: Children, attrs: Array<#(string, string)> = []) -> Element {
    return Element(tag: "ul", value: "", children: children, attrs: attrs);
}

pub fn li(children: Children, attrs: Array<#(string, string)> = []) -> Element {
    return Element(tag: "li", value: "", children: children, attrs: attrs);
}

pub fn renderToString(e: Element) -> string {
    if (e.tag == "#text") return e.value;
    var inner = "";
    for (e.children) { c ->
        inner = inner + renderToString(c);
    };
    if (e.tag == "#fragment") return inner;
    var attrStr = "";
    for (e.attrs) { a ->
        attrStr = attrStr + " " + a._0 + "=\"" + a._1 + "\"";
    };
    return "<" + e.tag + attrStr + ">" + inner + "</" + e.tag + ">";
}

test "leaf, fragment, and a nested tree render to HTML" {
    assert renderToString(text("hi", attrs: [])) == "hi";
    assert renderToString(fragment([text("a", attrs: []), text("b", attrs: [])], attrs: [])) == "ab";
    val tree = div([p([text("hi", attrs: [])], attrs: []), text("!", attrs: [])], attrs: []);
    assert renderToString(tree) == "<div><p>hi</p>!</div>";
}

test "deeply nested lists build and render (list form)" {
    val page = div([
            h1([text("Title", attrs: [])], attrs: []),
            ul([
                    li([text("one", attrs: [])], attrs: []),
                    li([span([text("t", attrs: []), text("wo", attrs: [])], attrs: [])], attrs: []),
                ], attrs: []),
        ], attrs: []);
    assert renderToString(page) == "<div><h1>Title</h1><ul><li>one</li><li><span>two</span></li></ul></div>";
}

val coerceList = div([text("a", attrs: []), text("b", attrs: [])], attrs: []);

val coerceSingle = div(text("only", attrs: []), attrs: []);

val coerceText = div("bare string", attrs: []);

test "Children coercion: list / single / string all type-check (G4)" {
    assert coerceList.tag == "div";
    assert coerceSingle.tag == "div";
    assert coerceText.tag == "div";
}
