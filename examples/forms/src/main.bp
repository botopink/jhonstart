// forms — prints the empty create-post form and the search form.

pub mod create_post;
pub mod like;
pub mod search;

import {renderToString} from "jhonstart";
import {formAction} from "jhonstart-forms";
import {state.newActionState} from "actions";
import {createPostForm} from "create_post";
import {SearchForm} from "search";

fn main() {
    @print(renderToString(createPostForm(formAction("a_9f31c0d7a4b2e5081c6fa3d2", "/blog/new", "__bp_action"), newActionState(""), false)));
    @print(renderToString(SearchForm()));
}
